---
const links = [
  { label: "Works", href: "/works/" },
  { label: "Writing", href: "/blog/" },
  { label: "Publications and Speaking", href: "/publications/" },
  { label: "Resume", href: "/assets/resume.pdf" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => (href.endsWith("/") ? pathname.startsWith(href) : pathname === href);
---

<header class="fixed left-0 top-0 z-50 w-full border-b border-[var(--color-border)] bg-[var(--color-page)]/95 backdrop-blur">
  <nav class="site-container flex h-[var(--topbar-height)] items-center justify-between" aria-label="Main navigation">
    <a class="flex min-w-0 items-center gap-2 pr-3 text-base font-normal no-underline" href="/">
      <img
        class="h-6 w-6 shrink-0 rounded-full object-cover"
        src="/assets/images/anise-olabode-michigan.jpg"
        alt="Olabode Anise"
        width="48"
        height="48"
      />
      <span class="truncate">Olabode</span>
    </a>

    <div class="hidden items-center gap-5 md:flex">
      {
        links.map((link) => {
          const active = isActive(link.href);

          return (
            <a
              class:list={[
                "text-sm underline underline-offset-4",
                active
                  ? "font-medium text-[var(--color-primary)] decoration-[var(--color-accent)]"
                  : "text-[var(--color-primary-muted)] decoration-transparent",
              ]}
              href={link.href}
              aria-current={active ? "page" : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        role="switch"
        aria-checked="false"
        aria-label="Switch to dark mode"
      >
        <span class="theme-toggle-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M12 7.8a4.2 4.2 0 1 0 0 8.4 4.2 4.2 0 0 0 0-8.4Z"
              stroke="currentColor"
              stroke-width="1.8"></path>
            <path
              d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="theme-toggle-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M20.2 14.8A7.2 7.2 0 0 1 9.2 3.8a8.6 8.6 0 1 0 11 11Z"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="theme-toggle-knob"></span>
      </button>
    </div>

    <button
      class="rounded-md border-0 bg-transparent px-0 py-2 text-sm text-[var(--color-primary)] md:hidden"
      type="button"
      data-menu-button
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      Menu
    </button>
  </nav>

  <div id="mobile-menu" class="site-container hidden pb-4 md:hidden" data-menu-panel>
    <div class="flex flex-col gap-3 border-t border-[var(--color-border)] pt-4">
      {
        links.map((link) => {
          const active = isActive(link.href);

          return (
            <a
              class:list={[
                "text-base underline underline-offset-4",
                active
                  ? "font-medium text-[var(--color-primary)] decoration-[var(--color-accent)]"
                  : "text-[var(--color-primary-muted)] decoration-transparent",
              ]}
              href={link.href}
              aria-current={active ? "page" : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      <button
        class="theme-toggle self-start"
        type="button"
        data-theme-toggle
        role="switch"
        aria-checked="false"
        aria-label="Switch to dark mode"
      >
        <span class="theme-toggle-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M12 7.8a4.2 4.2 0 1 0 0 8.4 4.2 4.2 0 0 0 0-8.4Z"
              stroke="currentColor"
              stroke-width="1.8"></path>
            <path
              d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="theme-toggle-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M20.2 14.8A7.2 7.2 0 0 1 9.2 3.8a8.6 8.6 0 1 0 11 11Z"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="theme-toggle-knob"></span>
      </button>
    </div>
  </div>
</header>
