---
interface Props {
  tags?: string[];
  className?: string;
}

const { tags = [], className = "" } = Astro.props;
---

{tags.length > 0 && (
  <ul class={`flex flex-wrap gap-2 ${className}`} aria-label="Tags">
    {tags.map((tag) => (
      <li>
        <span class="inline-flex rounded-md border border-[var(--color-border)] px-2 py-1 text-sm leading-none text-[var(--color-primary-soft)]">
          {tag}
        </span>
      </li>
    ))}
  </ul>
)}
