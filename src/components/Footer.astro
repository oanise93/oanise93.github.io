---
const year = new Date().getFullYear();
---

<footer class="site-container flex flex-col gap-4 border-t border-[var(--color-border)] pb-24 pt-5 text-sm text-[var(--color-primary-soft)] md:flex-row md:items-center md:justify-between">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <p>© {year} Olabode Anise.</p>
    <p>San Francisco</p>
  </div>

  <div class="flex items-center gap-3" aria-label="Theme">
    <button class="p-0 text-[var(--color-primary-soft)]" type="button" data-theme-option="system" aria-pressed="false">
      System
    </button>
    <button class="p-0 text-[var(--color-primary-soft)]" type="button" data-theme-option="light" aria-pressed="false">
      Light
    </button>
    <button class="p-0 text-[var(--color-primary-soft)]" type="button" data-theme-option="dark" aria-pressed="false">
      Dark
    </button>
  </div>
</footer>
